{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cbuild",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/gcc.exe",
            "args": [
                "-g",
                "-O0",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe",
                "-I${fileDirname}",
                "-lm"
            ],
            "group": "build",
            "problemMatcher": "$gcc"
        }
    ]
}
