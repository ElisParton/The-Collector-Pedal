{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-pa",
            "type": "shell",
            "command": "C:/msys64/mingw64/bin/gcc.exe",
            "args": [
                "main.c",
                "-o", "main.exe",

                // include path
                "-IC:/msys64/mingw64/include",

                // library search path
                "-LC:/msys64/mingw64/lib",

                // link libraries
                "-lportaudio",
                "-lwinmm"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc"
        }
    ]
}
